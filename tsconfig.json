{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "types": ["node", "office-js", "office-runtime"],
    "lib": ["es2022", "dom", "dom.iterable"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
